# 示例配置：填写到自己的 .env，切勿提交真实 Key。
QWEN_API_KEY=
QWEN_BASE_URL=https://api.openai-next.com/v1
QWEN_MODEL=deepseek-v4-1-flash-260910
QWEN_TIMEOUT=60
QWEN_MAX_RETRIES=1
SENSEVOICE_MODEL_DIR=D:\model\SenseVoiceSmall
ASR_DEVICE=cpu

# 独立绘图配置，供应商的 Key 和 Base URL 必须匹配。
IMAGE_API_KEY=
IMAGE_BASE_URL=https://api.openai-next.com/v1
IMAGE_MODEL=gpt-image-2
IMAGE_TIMEOUT=180
